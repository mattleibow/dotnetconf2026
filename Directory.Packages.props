<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
        <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="17.0.0" />
        <PackageVersion Include="Aspire.Hosting.Foundry" Version="17.0.0-preview.1.26567.5" />
        <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
        <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
        <PackageVersion Include="Aspire.Hosting.Maui" Version="17.0.0-preview.1.26567.5" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="17.0.0" />
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
        <PackageVersion Include="Markdig.Signed" Version="0.43.0" />
        <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
        <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
        <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
        <PackageVersion Include="Microsoft.Maui.AI.Attributes" Version="0.1.0-preview.14.26555.2" />
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageVersion Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.14.26555.2" />
        <PackageVersion Include="Microsoft.Maui.Essentials.AI" Version="11.0.0-preview.9.26567.2" />
        <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
        <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.20.0" />
        <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
        <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    </ItemGroup>

</Project>
