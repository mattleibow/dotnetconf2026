    xmlns:views="clr-namespace:ConferenceApp.Views"
    Title=".NET Conf South Africa">

    <TabBar>
        <ShellContent Title="Agenda" Route="agenda" ContentTemplate="{DataTemplate views:AgendaPage}" />
        <ShellContent Title="Speakers" Route="speakers" ContentTemplate="{DataTemplate views:SpeakersPage}" />
        <ShellContent Title="Favourites" Route="favourites" ContentTemplate="{DataTemplate views:FavoritesPage}" />
        <ShellContent Title="Venue" Route="venue" ContentTemplate="{DataTemplate views:VenuePage}" />
        <ShellContent Title="Sponsors" Route="sponsors" ContentTemplate="{DataTemplate views:SponsorsPage}" />
        <ShellContent Title="Assistant" Route="assistant" ContentTemplate="{DataTemplate views:ChatPage}" />
    </TabBar>

</Shell>
