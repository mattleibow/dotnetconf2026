<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConferenceApp.Views.VenuePage"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:DataType="vm:VenueViewModel"
             Title="Venue">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Label Text="{Binding Venue.Name}" FontAttributes="Bold" />
            <Label Text="{Binding Venue.Address}" />
            <maps:Map x:Name="VenueMap"
                      AutomationId="venue-map"
                      HeightRequest="240"
                      IsShowingUser="False" />
            <Button AutomationId="open-map" Text="Open in Maps" Command="{Binding OpenMapCommand}" />
            <Label Text="{Binding Description}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
