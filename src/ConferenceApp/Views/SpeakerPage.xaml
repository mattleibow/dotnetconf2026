<ContentPage x:Class="ConferenceApp.Views.SpeakerPage"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels"
             x:DataType="vm:SpeakerViewModel" Title="Speaker">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" MaximumWidthRequest="1100">
            <Border Background="{StaticResource BrandGradient}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="24">
                <VerticalStackLayout Spacing="12">
                    <Border StrokeShape="RoundRectangle 48" HeightRequest="96" WidthRequest="96" Padding="0" HorizontalOptions="Start">
                        <Grid>
                            <Label Text="{Binding Initials}" Style="{StaticResource HeaderTitle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image Source="{Binding Photo}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding Name}" Style="{StaticResource HeaderTitle}" />
                    <Label Text="{Binding Tagline}" Style="{StaticResource HeaderText}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding Status}" />
            <Label Text="About" Style="{StaticResource TitleText}" />
            <Label Text="{Binding Bio}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
