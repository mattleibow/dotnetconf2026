<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConferenceApp.Views.SpeakerPage"
             x:DataType="SpeakerViewModel"
             Title="Speaker">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Label Text="{Binding Speaker.Name}" FontAttributes="Bold" />
            <Label Text="{Binding Speaker.Tagline}" />
            <Label Text="{Binding Bio}" />
            <Label Text="Sessions" FontAttributes="Bold" />
            <VerticalStackLayout AutomationId="speaker-sessions" BindableLayout.ItemsSource="{Binding Sessions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="SessionItem">
                        <VerticalStackLayout Padding="0,4" Background="Transparent" AutomationId="{Binding Session.Id, StringFormat='speaker-session-{0}'}">
                            <Label Text="{Binding Meta}" />
                            <Label Text="{Binding Topic}" IsVisible="{Binding HasTopic}" />
                            <Label Text="{Binding Session.Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Summary}" IsVisible="{Binding HasSummary}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSessionCommand, Source={RelativeSource AncestorType={x:Type SpeakerViewModel}}, x:DataType=SpeakerViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
