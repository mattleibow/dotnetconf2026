<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.SpeakerPage"
          x:DataType="SpeakerViewModel"
          Title="Speaker">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="1100">
            <!-- Speaker Profile Card -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Border StrokeShape="RoundRectangle 48"
                            StrokeThickness="0"
                            HeightRequest="96"
                            WidthRequest="96"
                            Padding="0"
                            Background="{StaticResource SecondaryBrandBrush}"
                            HorizontalOptions="Center">
                        <Grid>
                            <Label Text="{Binding Speaker.Initials}"
                                   Style="{StaticResource Title}"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Image Source="{Binding Speaker.Image, Converter={StaticResource PackagedImage}}"
                                   Aspect="AspectFill"
                                   HeightRequest="96"
                                   WidthRequest="96" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Speaker.Name}"
                               Style="{StaticResource Title}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Speaker.Tagline}"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Margin="0,4"
                             IsVisible="{!string.IsNullOrWhiteSpace(Bio)}" />

                    <Label FormattedText="{Binding Bio, Converter={StaticResource MarkdownConverter}}"
                           Style="{StaticResource Body}"
                           IsVisible="{!string.IsNullOrWhiteSpace(Bio)}" />
                </VerticalStackLayout>
            </Border>

            <!-- Speaker Sessions -->
            <VerticalStackLayout Spacing="10">
                <Label Text="SESSIONS" Style="{StaticResource SectionHeader}" />
                <VerticalStackLayout AutomationId="speaker-sessions"
                                     Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Sessions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="Session">
                            <Border Style="{StaticResource CardBorder}"
                                    AutomationId="{$'speaker-session-{Id}'}">
                                <VerticalStackLayout Spacing="8" Background="Transparent">
                                    <Label Text="{Binding CityMeta}"
                                           Style="{StaticResource Label}" />
                                    <HorizontalStackLayout Spacing="6"
                                                           IsVisible="{Topics.Count > 0}"
                                                           BindableLayout.ItemsSource="{Binding Topics}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Style="{StaticResource TopicPillBorder}">
                                                    <Label Text="{Binding .}"
                                                           Style="{StaticResource TopicPillLabel}" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource Subtitle}" />
                                    <Label Text="{Binding Summary}"
                                           IsVisible="{!string.IsNullOrWhiteSpace(Summary)}"
                                           Style="{StaticResource Body}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSessionCommand, Source={RelativeSource AncestorType={x:Type SpeakerViewModel}}, x:DataType=SpeakerViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</BasePage>
