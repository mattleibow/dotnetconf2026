<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConferenceApp.Views.AgendaPage"
             x:DataType="AgendaViewModel"
             Title="Agenda">
    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="city-picker"
                     Text="{Binding SelectedCity.Name, FallbackValue='City'}"
                     Command="{Binding PickCityCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry AutomationId="agenda-search"
                   Placeholder="Search sessions or speakers..."
                   Text="{Binding SearchQuery}"
                   ClearButtonVisibility="WhileEditing" />
            <Button Grid.Column="1"
                    AutomationId="favorites-filter"
                    Text="{ShowFavoritesOnly ? 'Showing: Favourites' : 'Showing: All Sessions'}"
                    Command="{Binding ToggleFavoritesFilterCommand}" />
        </Grid>
        <CollectionView Grid.Row="1" AutomationId="session-list" ItemsSource="{Binding Sessions}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="SessionItem">
                    <VerticalStackLayout Padding="0,8" Background="Transparent" AutomationId="{Binding Session.Id, StringFormat='session-{0}'}">
                        <Label Text="{Binding Meta}" />
                        <Label Text="{Binding Topic}" IsVisible="{!string.IsNullOrWhiteSpace(Topic)}" />
                        <Label Text="{Binding Session.Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Summary}" IsVisible="{!string.IsNullOrWhiteSpace(Summary)}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Speakers}" />
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSessionCommand, Source={RelativeSource AncestorType={x:Type AgendaViewModel}}, x:DataType=AgendaViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
