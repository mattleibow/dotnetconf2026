<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.AgendaPage"
          x:DataType="AgendaViewModel"
          Title="Agenda">
    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="city-picker"
                     Text="{Binding SelectedCity.Name, FallbackValue='City'}"
                     Command="{Binding PickCityCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12" MaximumWidthRequest="1100">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border Style="{StaticResource SearchContainerBorder}">
                <Entry AutomationId="agenda-search"
                       Placeholder="Search sessions, topics, or speakers..."
                       Text="{Binding SearchQuery}"
                       ClearButtonVisibility="WhileEditing" />
            </Border>
            <Button Grid.Column="1"
                    AutomationId="favorites-filter"
                    Style="{StaticResource SecondaryButton}"
                    Text="{ShowFavoritesOnly ? 'Showing: Favourites' : 'Showing: All Sessions'}"
                    Command="{Binding ToggleFavoritesFilterCommand}" />
        </Grid>

        <CollectionView Grid.Row="1" AutomationId="session-list" ItemsSource="{Binding Sessions}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="Session">
                    <Border Style="{StaticResource CardBorder}"
                            Margin="0,6"
                            AutomationId="{$'session-{Id}'}">
                        <VerticalStackLayout Spacing="8" Background="Transparent">
                            <Label Text="{Binding Meta}"
                                   Style="{StaticResource Label}" />
                            <HorizontalStackLayout Spacing="6"
                                                   IsVisible="{Topics.Count > 0}"
                                                   BindableLayout.ItemsSource="{Binding Topics}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Style="{StaticResource TopicPillBorder}">
                                            <Label Text="{Binding .}"
                                                   Style="{StaticResource TopicPillLabel}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource Subtitle}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Summary}"
                                   IsVisible="{!string.IsNullOrWhiteSpace(Summary)}"
                                   Style="{StaticResource Body}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SpeakerNames}"
                                   IsVisible="{!string.IsNullOrWhiteSpace(SpeakerNames)}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSessionCommand, Source={RelativeSource AncestorType={x:Type AgendaViewModel}}, x:DataType=AgendaViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</BasePage>
