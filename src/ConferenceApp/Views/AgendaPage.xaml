<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels"
             xmlns:views="clr-namespace:ConferenceApp.Views"
             x:Class="ConferenceApp.Views.AgendaPage" x:DataType="vm:AgendaViewModel"
             Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <ContentPage.Resources>
        <DataTemplate x:Key="TalkTemplate" x:DataType="vm:SessionItem">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" AutomationId="{Binding AutomationId}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Track}" Style="{StaticResource MetadataText}"/>
                        <Label Text="{Binding Title}" Style="{StaticResource SubtitleText}"/>
                        <Label Text="{Binding MatchText}" IsVisible="{Binding HasMatchText}" Style="{StaticResource BodyText}" AutomationId="{Binding MatchAutomationId}"/>
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding SpeakerItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpeakerItem">
                                    <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                                        <Grid HeightRequest="32" WidthRequest="32">
                                            <Border IsVisible="{Binding ShowInitials}" BackgroundColor="{StaticResource BrandSecondary}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                                <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource CaptionText}"/>
                                            </Border>
                                            <Image Source="{Binding Photo}" IsVisible="{Binding HasPhoto}" Aspect="AspectFill">
                                                <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                                            </Image>
                                        </Grid>
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" Style="{StaticResource BodyText}"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding Time}" Style="{StaticResource CaptionText}"/>
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="{Binding Heart}" Command="{Binding FavoriteCommand}" AutomationId="{Binding FavoriteAutomationId}"
                                 WidthRequest="48" HeightRequest="48" Padding="12" VerticalOptions="Center" BackgroundColor="Transparent" SemanticProperties.Description="{Binding FavoriteDescription}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GeneralTemplate" x:DataType="vm:SessionItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="12,8" AutomationId="{Binding AutomationId}">
                <Label Text="{Binding Time}" Style="{StaticResource CaptionText}" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{Binding Title}" Style="{StaticResource BodyText}" VerticalOptions="Center"/>
                    <Label Text="{Binding MatchText}" IsVisible="{Binding HasMatchText}" Style="{StaticResource BodyText}" AutomationId="{Binding MatchAutomationId}"/>
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
        <views:SessionTemplateSelector x:Key="SessionTemplates" Talk="{StaticResource TalkTemplate}" General="{StaticResource GeneralTemplate}"/>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Background="{StaticResource BrandGradient}">
        <VerticalStackLayout Padding="24,16,24,12" Spacing="6" MaximumWidthRequest="1100" HorizontalOptions="Fill">
            <Label Text=".NET CONF 2026  •  SOUTH AFRICA" TextColor="White" Style="{StaticResource CaptionText}"/>
            <Label Text="Your conference agenda" TextColor="White" Style="{StaticResource DisplayText}"/>
            <Label Text="{Binding Date}" TextColor="White" Style="{StaticResource BodyText}"/>
            <FlexLayout Wrap="Wrap" AlignItems="Center">
                <Button Text="Durban" Command="{Binding SelectCityCommand}" CommandParameter="durban" AutomationId="city-durban" Margin="0,0,8,4">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsDurban}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource White}"/><Setter Property="TextColor" Value="{StaticResource BrandDark}"/></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="Cape Town" Command="{Binding SelectCityCommand}" CommandParameter="cape-town" AutomationId="city-cape-town" Margin="0,0,8,4">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsCapeTown}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource White}"/><Setter Property="TextColor" Value="{StaticResource BrandDark}"/></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="Bloemfontein" Command="{Binding SelectCityCommand}" CommandParameter="bloemfontein" AutomationId="city-bloemfontein" Margin="0,0,8,4">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsBloemfontein}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource White}"/><Setter Property="TextColor" Value="{StaticResource BrandDark}"/></DataTrigger></Button.Triggers>
                </Button>
            </FlexLayout>
            <Button Text="Find nearest city" Command="{Binding FindNearestCommand}" AutomationId="nearest-city" HorizontalOptions="Start"/>
        </VerticalStackLayout>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,*" MaximumWidthRequest="1100" HorizontalOptions="Fill">
            <SearchBar Text="{Binding SearchText}" Placeholder="Search sessions" AutomationId="agenda-search" Margin="16,8,16,0" SemanticProperties.Description="Search sessions in the selected city"/>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Groups}" IsGrouped="True" AutomationId="session-list" Margin="16,8" ItemTemplate="{StaticResource SessionTemplates}">
                <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="8"/></CollectionView.ItemsLayout>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="Layout">
                        <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers></VisualState>
                        <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
                            <VisualState.Setters><Setter Property="ItemsLayout"><Setter.Value><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8"/></Setter.Value></Setter></VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <CollectionView.EmptyView><Label Text="{Binding EmptyMessage}" Style="{StaticResource BodyText}" Margin="16"/></CollectionView.EmptyView>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:SessionGroup">
                        <Grid Padding="4,16,4,8">
                            <Label Text="{Binding Title}" Style="{StaticResource SubtitleText}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
            </CollectionView>
            <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            <Label Grid.Row="1" Text="{Binding Error}" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
