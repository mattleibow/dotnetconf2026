<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.SpeakersPage"
          x:DataType="SpeakersViewModel"
          Title="Speakers">
    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="city-picker"
                     Text="{Binding SelectedCity.Name, FallbackValue='City'}"
                     Command="{Binding PickCityCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16,12,16,0">
        <CollectionView AutomationId="speaker-list" ItemsSource="{Binding Speakers}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="{OnIdiom Phone=1, Default=2}"
                                 VerticalItemSpacing="12"
                                 HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="Speaker">
                    <Border Style="{StaticResource CardBorder}"
                            Padding="16"
                            AutomationId="{Binding Id, StringFormat='speaker-{0}'}">
                        <Grid ColumnDefinitions="68,*,Auto"
                              ColumnSpacing="14"
                              Background="Transparent">
                            <!-- Gradient Ring Avatar -->
                            <Border StrokeShape="RoundRectangle 34"
                                    StrokeThickness="0"
                                    HeightRequest="68"
                                    WidthRequest="68"
                                    Padding="3"
                                    Background="{StaticResource HeroGradientBrush}"
                                    VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 31"
                                        StrokeThickness="0"
                                        HeightRequest="62"
                                        WidthRequest="62"
                                        Padding="0"
                                        Background="{StaticResource SecondaryBrandBrush}">
                                    <Grid>
                                        <Label Text="{Binding Initials}"
                                               Style="{StaticResource Subtitle}"
                                               TextColor="{StaticResource White}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image Source="{Binding Image, Converter={StaticResource PackagedImage}}"
                                               Aspect="AspectFill"
                                               HeightRequest="62"
                                               WidthRequest="62" />
                                    </Grid>
                                </Border>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6"
                                                 VerticalOptions="Center"
                                                 Background="Transparent">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Subtitle}"
                                       FontSize="17" />
                                <Label Text="{Binding Tagline}"
                                       Style="{StaticResource Caption}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{!string.IsNullOrWhiteSpace(Tagline)}" />
                                <HorizontalStackLayout Spacing="6"
                                                       BindableLayout.ItemsSource="{Binding CityIds}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Style="{StaticResource TopicPillBorder}"
                                                    Padding="10,3">
                                                <Label Text="{Binding .}"
                                                       Style="{StaticResource TopicPillLabel}"
                                                       FontSize="10"
                                                       TextTransform="Uppercase" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="24"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSpeakerCommand, Source={RelativeSource AncestorType={x:Type SpeakersViewModel}}, x:DataType=SpeakersViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</BasePage>
