<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConferenceApp.Views.SponsorsPage"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels"
             xmlns:m="clr-namespace:ConferenceApp.Models"
             x:DataType="vm:SponsorsViewModel"
             Title="Sponsors">
    <CollectionView AutomationId="sponsor-list" ItemsSource="{Binding Sponsors}" Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="m:Sponsor">
                <VerticalStackLayout Padding="0,8" Background="Transparent" AutomationId="{Binding Id, StringFormat='sponsor-{0}'}">
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Text="{Binding Tier}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.OpenSponsorCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}, x:DataType=ContentPage}"
                                              CommandParameter="{Binding .}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
