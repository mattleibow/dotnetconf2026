<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels" x:Class="ConferenceApp.Views.SponsorDetailPage"
             x:DataType="vm:SponsorDetailViewModel" Title="Sponsor"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <ScrollView AutomationId="sponsor-detail">
        <VerticalStackLayout Spacing="0">
            <Grid Background="{StaticResource BrandGradient}">
                <VerticalStackLayout Padding="24,32" Spacing="8" MaximumWidthRequest="1100" HorizontalOptions="Fill">
                    <Label Text=".NET CONF 2026  •  SPONSOR" TextColor="White" Style="{StaticResource CaptionText}"/>
                    <Label Text="{Binding Name}" TextColor="White" Style="{StaticResource DisplayText}"/>
                    <Label Text="{Binding City}" TextColor="White" Style="{StaticResource BodyText}"/>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="1100" HorizontalOptions="Fill">
                <Border Style="{StaticResource Card}" BackgroundColor="White">
                    <Image Source="{Binding Logo}" HeightRequest="160" Aspect="AspectFit" SemanticProperties.Description="{Binding Name}"/>
                </Border>
                <Label Text="{Binding Tier}" Style="{StaticResource MetadataText}"/>
                <Button Text="Visit website" Command="{Binding OpenWebsiteCommand}" IsVisible="{Binding HasWebsite}"
                        AutomationId="sponsor-website" HorizontalOptions="Start"/>
                <Label Text="{Binding Error}" Style="{StaticResource BodyText}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
