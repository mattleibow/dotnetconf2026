<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.SessionPage"
          x:DataType="SessionViewModel"
          Title="Session">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="20" MaximumWidthRequest="1100">
            <!-- Hero Session Pass Header -->
            <Border Style="{StaticResource HeroPassBorder}">
                <Grid>
                    <Border StrokeShape="RoundRectangle 120"
                            StrokeThickness="0"
                            WidthRequest="220"
                            HeightRequest="220"
                            Background="{StaticResource HeroGlowPinkBrush}"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-70,-60,0"
                            InputTransparent="True" />

                    <VerticalStackLayout Padding="24" Spacing="14">
                        <Border Style="{StaticResource FrostedPillBorder}"
                                HorizontalOptions="Start">
                            <Label Text="{Binding Session.CityMeta}"
                                   Style="{StaticResource Label}"
                                   TextColor="{StaticResource White}" />
                        </Border>

                        <Label Text="{Binding Session.Title}"
                               Style="{StaticResource Display}"
                               FontSize="26" />

                        <VerticalStackLayout BindingContext="{Binding Session, x:DataType=SessionViewModel}">
                            <HorizontalStackLayout Spacing="6"
                                                   x:DataType="Session"
                                                   IsVisible="{Topics.Count > 0}"
                                                   BindableLayout.ItemsSource="{Binding Topics}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Style="{StaticResource FrostedPillBorder}"
                                                Padding="12,4">
                                            <Label Text="{Binding .}"
                                                   Style="{StaticResource Label}"
                                                   TextColor="{StaticResource White}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Button AutomationId="favorite-button"
                                Style="{StaticResource AccentButton}"
                                Margin="0,4,0,0"
                                Text="{IsFavorite ? 'Remove from favourites' : 'Add to favourites'}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Speakers Section -->
            <VerticalStackLayout AutomationId="session-speakers"
                                 Spacing="10"
                                 BindableLayout.ItemsSource="{Binding Speakers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="Speaker">
                        <Border Style="{StaticResource CardBorder}"
                                Padding="14"
                                AutomationId="{Binding Id, StringFormat='session-speaker-{0}'}">
                            <Grid ColumnDefinitions="54,*,Auto"
                                  ColumnSpacing="14"
                                  Background="Transparent">
                                <Border StrokeShape="RoundRectangle 27"
                                        StrokeThickness="0"
                                        HeightRequest="54"
                                        WidthRequest="54"
                                        Padding="2"
                                        Background="{StaticResource HeroGradientBrush}"
                                        VerticalOptions="Center">
                                    <Border StrokeShape="RoundRectangle 25"
                                            StrokeThickness="0"
                                            HeightRequest="50"
                                            WidthRequest="50"
                                            Padding="0"
                                            Background="{StaticResource SecondaryBrandBrush}">
                                        <Grid>
                                            <Label Text="{Binding Initials}"
                                                   Style="{StaticResource Caption}"
                                                   TextColor="{StaticResource White}"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding Image, Converter={StaticResource PackagedImage}}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="50"
                                                   WidthRequest="50" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center"
                                                     Background="Transparent">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource Subtitle}"
                                           FontSize="16" />
                                    <Label Text="{Binding Tagline}"
                                           Style="{StaticResource Caption}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="22"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSpeakerCommand, Source={RelativeSource AncestorType={x:Type SessionViewModel}}, x:DataType=SessionViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Abstract Card -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="20"
                    IsVisible="{!string.IsNullOrWhiteSpace(Description)}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="4"
                                 HeightRequest="16"
                                 CornerRadius="2"
                                 Fill="{StaticResource AccentGradientBrush}" />
                        <Label Text="SESSION ABSTRACT" Style="{StaticResource SectionHeader}" />
                    </HorizontalStackLayout>
                    <Label FormattedText="{Binding Description, Converter={StaticResource MarkdownConverter}}"
                           Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</BasePage>
