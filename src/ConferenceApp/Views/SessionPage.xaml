<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConferenceApp.Views.SessionPage"
             x:DataType="SessionViewModel"
             Title="Session">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Label Text="{Binding Session.Title}" FontAttributes="Bold" />
            <Label Text="{Binding Session.Time}" />
            <Label Text="{Binding Session.Track}" />
            <Button AutomationId="favorite-button" Text="{IsFavorite ? 'Remove from favourites' : 'Add to favourites'}" Command="{Binding ToggleFavoriteCommand}" />
            <VerticalStackLayout AutomationId="session-speakers" BindableLayout.ItemsSource="{Binding Speakers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="Speaker">
                        <Label Text="{Binding Name}" Padding="0,4" Background="Transparent" AutomationId="{Binding Id, StringFormat='session-speaker-{0}'}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSpeakerCommand, Source={RelativeSource AncestorType={x:Type SessionViewModel}}, x:DataType=SessionViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="{Binding Description}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
