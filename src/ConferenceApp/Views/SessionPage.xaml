<ContentPage x:Class="ConferenceApp.Views.SessionPage"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels"
             x:DataType="vm:SessionViewModel" Title="Session">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" MaximumWidthRequest="1100">
            <Border Background="{StaticResource BrandGradient}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="24">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Track}" Style="{StaticResource HeaderText}" />
                    <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}" />
                    <Label Text="{Binding Time}" Style="{StaticResource HeaderText}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding Status}" />
            <Button Text="{Binding FavoriteText}" Command="{Binding ToggleFavoriteCommand}" AutomationId="session-favorite-button" />
            <Grid x:Name="DetailGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="24" ColumnSpacing="24">
                <VerticalStackLayout x:Name="SpeakerSection" Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Speakers.Count}" Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>
                    <Label Text="Speakers" Style="{StaticResource TitleText}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Speakers}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerCard">
                                <Border Style="{StaticResource Card}" AutomationId="{Binding AutomationId}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenSpeakerCommand, Source={RelativeSource AncestorType={x:Type vm:SessionViewModel}}, x:DataType=vm:SessionViewModel}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                        <Border StrokeShape="RoundRectangle 28" HeightRequest="56" WidthRequest="56" Padding="0">
                                            <Grid>
                                                <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Image Source="{Binding Photo}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding Tagline}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="AbstractSection" Grid.Row="1" Spacing="12">
                    <Label Text="About this session" Style="{StaticResource TitleText}" />
                    <Label Text="{Binding Abstract}" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
