<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.SessionPage"
          x:DataType="SessionViewModel"
          Title="Session">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="1100">
            <!-- Session Header Card -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Session.CityMeta}"
                           Style="{StaticResource Label}" />
                    <Label Text="{Binding Session.Title}"
                           Style="{StaticResource Title}" />
                    <VerticalStackLayout BindingContext="{Binding Session, x:DataType=SessionViewModel}">
                        <HorizontalStackLayout Spacing="6"
                                               x:DataType="Session"
                                               IsVisible="{Topics.Count > 0}"
                                               BindableLayout.ItemsSource="{Binding Topics}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource TopicPillBorder}">
                                        <Label Text="{Binding .}"
                                               Style="{StaticResource TopicPillLabel}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button AutomationId="favorite-button"
                            Style="{StaticResource AccentButton}"
                            Text="{IsFavorite ? 'Remove from favourites' : 'Add to favourites'}"
                            Command="{Binding ToggleFavoriteCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Speakers Section -->
            <VerticalStackLayout AutomationId="session-speakers"
                                 Spacing="10"
                                 BindableLayout.ItemsSource="{Binding Speakers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="Speaker">
                        <Border Style="{StaticResource CompactCardBorder}"
                                AutomationId="{Binding Id, StringFormat='session-speaker-{0}'}">
                            <Grid ColumnDefinitions="44,*"
                                  ColumnSpacing="12"
                                  Background="Transparent">
                                <Border StrokeShape="RoundRectangle 22"
                                        StrokeThickness="0"
                                        HeightRequest="44"
                                        WidthRequest="44"
                                        Padding="0"
                                        Background="{StaticResource SecondaryBrandBrush}"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="{Binding Initials}"
                                               Style="{StaticResource Caption}"
                                               TextColor="{StaticResource White}"
                                               FontFamily="OpenSansSemibold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image Source="{Binding Image, Converter={StaticResource PackagedImage}}"
                                               Aspect="AspectFill"
                                               HeightRequest="44"
                                               WidthRequest="44" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center"
                                                     Background="Transparent">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource Subtitle}"
                                           FontSize="15" />
                                    <Label Text="{Binding Tagline}"
                                           Style="{StaticResource Caption}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSpeakerCommand, Source={RelativeSource AncestorType={x:Type SessionViewModel}}, x:DataType=SessionViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Abstract Card -->
            <Border Style="{StaticResource CardBorder}"
                    IsVisible="{!string.IsNullOrWhiteSpace(Description)}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ABSTRACT" Style="{StaticResource SectionHeader}" />
                    <Label FormattedText="{Binding Description, Converter={StaticResource MarkdownConverter}}"
                           Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</BasePage>
