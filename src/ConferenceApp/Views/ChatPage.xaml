<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.ChatPage"
          x:DataType="ChatViewModel"
          Title="Assistant">
    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="city-picker"
                     Text="{Binding SelectedCity.Name, FallbackValue='City'}"
                     Command="{Binding PickCityCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,16" RowSpacing="12">
        <!-- Unavailable Banner -->
        <Border Style="{StaticResource WarningBannerBorder}"
                IsVisible="{!string.IsNullOrEmpty(UnavailableReason)}">
            <Label AutomationId="chat-unavailable"
                   Text="{Binding UnavailableReason}"
                   Style="{StaticResource Caption}"
                   FontFamily="OpenSansSemibold"
                   TextColor="{AppThemeBinding Light={StaticResource WarningTextLight}, Dark={StaticResource WarningTextDark}}" />
        </Border>

        <!-- Messages & Starter Suggestions -->
        <CollectionView Grid.Row="1" AutomationId="chat-messages" ItemsSource="{Binding Messages}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="20"
                                     Padding="12"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     MaximumWidthRequest="580">
                    <!-- AI Concierge Hero Banner -->
                    <Border Style="{StaticResource HeroPassBorder}"
                            Padding="24,22">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border Style="{StaticResource FrostedPillBorder}"
                                    HorizontalOptions="Center">
                                <Label Text="ON-DEVICE AI CONCIERGE"
                                       Style="{StaticResource Label}"
                                       TextColor="{StaticResource White}" />
                            </Border>
                            <Label Text="Ask anything about .NET Conf"
                                   Style="{StaticResource Display}"
                                   FontSize="24"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Explore sessions, speakers, takeaways, and schedule clashes across Durban, Cape Town, and Bloemfontein."
                                   Style="{StaticResource Body}"
                                   TextColor="{StaticResource Secondary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="10"
                                         IsEnabled="{string.IsNullOrEmpty(UnavailableReason) AND !IsBusy}"
                                         BindableLayout.ItemsSource="{Binding Suggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}"
                                        Style="{StaticResource SuggestionButton}"
                                        Command="{Binding AskSuggestionCommand, Source={RelativeSource AncestorType={x:Type ChatViewModel}}, x:DataType=ChatViewModel}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ChatItem">
                    <VerticalStackLayout Padding="0,6" Spacing="8">
                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceLightBrush}, Dark={StaticResource SurfaceDarkBrush}}"
                                Padding="16,12"
                                Shadow="{StaticResource CardElevationShadow}"
                                MaximumWidthRequest="680"
                                HorizontalOptions="{IsUser ? LayoutOptions.End : LayoutOptions.Start}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HeroGradientBrush}" />
                                    <Setter Property="StrokeThickness" Value="0" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="6">
                                <Border Style="{StaticResource TopicPillBorder}"
                                        HorizontalOptions="Start"
                                        IsVisible="{!string.IsNullOrWhiteSpace(Progress)}">
                                    <Label AutomationId="chat-progress"
                                           Text="{Binding Progress}"
                                           Style="{StaticResource TopicPillLabel}"
                                           FontAttributes="Italic" />
                                </Border>
                                <Label FormattedText="{Binding Text, Converter={StaticResource MarkdownConverter}}"
                                       Style="{StaticResource Body}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Referenced Session Cards -->
                        <VerticalStackLayout Spacing="8"
                                             MaximumWidthRequest="680"
                                             HorizontalOptions="Start"
                                             BindableLayout.ItemsSource="{Binding Sessions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="Session">
                                    <Border Style="{StaticResource CompactCardBorder}"
                                            AutomationId="{$'chat-session-card-{Id}'}">
                                        <VerticalStackLayout Spacing="4" Background="Transparent">
                                            <Label Text="{Binding CityMeta}"
                                                   Style="{StaticResource Label}" />
                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource Subtitle}"
                                                   FontSize="15" />
                                            <Label Text="{Binding SpeakerNames}"
                                                   Style="{StaticResource Caption}"
                                                   IsVisible="{!string.IsNullOrWhiteSpace(SpeakerNames)}" />
                                        </VerticalStackLayout>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenSessionCommand, Source={RelativeSource AncestorType={x:Type ChatViewModel}}, x:DataType=ChatViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Input Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button AutomationId="chat-new"
                    Text="New chat"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearChatCommand}" />
            <Border Grid.Column="1" Style="{StaticResource SearchContainerBorder}">
                <Entry AutomationId="chat-input"
                       Placeholder="Ask about sessions, speakers, or your schedule..."
                       Text="{Binding Prompt}"
                       IsEnabled="{string.IsNullOrEmpty(UnavailableReason) AND !IsBusy}"
                       ReturnCommand="{Binding SendCommand}" />
            </Border>
            <Button Grid.Column="2"
                    AutomationId="chat-send"
                    Text="Send"
                    Style="{StaticResource AccentButton}"
                    Padding="18,10"
                    CornerRadius="14"
                    MinimumHeightRequest="44"
                    IsEnabled="{string.IsNullOrEmpty(UnavailableReason) AND !IsBusy}"
                    Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</BasePage>
