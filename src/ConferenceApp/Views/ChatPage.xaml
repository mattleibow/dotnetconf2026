<?xml version="1.0" encoding="utf-8" ?>
<BasePage x:Class="ConferenceApp.Views.ChatPage"
          x:DataType="ChatViewModel"
          Title="Assistant">
    <ContentPage.Resources>
        <MarkdownToFormattedStringConverter x:Key="MarkdownConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="city-picker"
                     Text="{Binding SelectedCity.Name, FallbackValue='City'}"
                     Command="{Binding PickCityCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="10">
        <Label AutomationId="chat-unavailable"
               Text="{Binding UnavailableReason}"
               IsVisible="{!string.IsNullOrEmpty(UnavailableReason)}" />

        <CollectionView Grid.Row="1" AutomationId="chat-messages" ItemsSource="{Binding Messages}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8"
                                     VerticalOptions="Center"
                                     IsEnabled="{string.IsNullOrEmpty(UnavailableReason) AND !IsBusy}"
                                     BindableLayout.ItemsSource="{Binding Suggestions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}"
                                    Command="{Binding AskSuggestionCommand, Source={RelativeSource AncestorType={x:Type ChatViewModel}}, x:DataType=ChatViewModel}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ChatItem">
                    <VerticalStackLayout Padding="0,6" Spacing="6">
                        <Label AutomationId="chat-progress"
                               Text="{Binding Progress}"
                               FontAttributes="Italic"
                               IsVisible="{!string.IsNullOrWhiteSpace(Progress)}" />
                        <Label FormattedText="{Binding Text, Converter={StaticResource MarkdownConverter}}" />

                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Sessions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="Session">
                                    <VerticalStackLayout Padding="8"
                                                         Background="Transparent"
                                                         AutomationId="{$'chat-session-card-{Id}'}">
                                        <Label Text="{Binding CityMeta}" />
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding SpeakerNames}" />
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenSessionCommand, Source={RelativeSource AncestorType={x:Type ChatViewModel}}, x:DataType=ChatViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button AutomationId="chat-new"
                    Text="New chat"
                    Command="{Binding ClearChatCommand}" />
            <Entry Grid.Column="1"
                   AutomationId="chat-input"
                   Placeholder="Ask about sessions, speakers, or your schedule..."
                   Text="{Binding Prompt}"
                   IsEnabled="{string.IsNullOrEmpty(UnavailableReason) AND !IsBusy}"
                   ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="2"
                    AutomationId="chat-send"
                    Text="Send"
                    IsEnabled="{string.IsNullOrEmpty(UnavailableReason) AND !IsBusy}"
                    Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</BasePage>
