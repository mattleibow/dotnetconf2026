<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels" x:Class="ConferenceApp.Views.SessionDetailPage"
             x:DataType="vm:SessionDetailViewModel" Title="Session"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Grid Background="{StaticResource BrandGradient}">
            <VerticalStackLayout Padding="24,32" Spacing="12" MaximumWidthRequest="1100" HorizontalOptions="Fill">
                <Label Text=".NET CONF 2026  •  SESSION" TextColor="White" Style="{StaticResource CaptionText}"/>
                <Label Text="{Binding Title}" TextColor="White" Style="{StaticResource DisplayText}"/>
                <Label Text="{Binding Time}" TextColor="White" Style="{StaticResource SubtitleText}"/>
                <Label Text="{Binding Track}" TextColor="White" Style="{StaticResource BodyText}"/>
                <Label Text="{Binding CityAndDate}" TextColor="White" Style="{StaticResource BodyText}"/>
            </VerticalStackLayout>
            </Grid>
            <Grid x:Name="DetailGrid" MaximumWidthRequest="1100" HorizontalOptions="Fill" Padding="24,24,24,112" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="24" ColumnSpacing="32">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="Layout">
                        <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers></VisualState>
                        <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="ColumnDefinitions" Value="2*,*"/>
                                <Setter TargetName="People" Property="Grid.Row" Value="0"/>
                                <Setter TargetName="People" Property="Grid.Column" Value="1"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <VerticalStackLayout Spacing="16">
                    <Button Text="{Binding FavoriteText}" Command="{Binding FavoriteCommand}" IsVisible="{Binding CanFavorite}" AutomationId="detail-favorite-button" HorizontalOptions="Start"/>
                    <Label Text="About this session" Style="{StaticResource TitleText}"/>
                    <Label Text="{Binding Abstract}" Style="{StaticResource BodyText}"/>
                    <Label Text="{Binding Error}"/>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="People" Grid.Row="1" Spacing="12">
                    <Label Text="Speakers" Style="{StaticResource TitleText}"/>
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Speakers}">
                      <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpeakerItem">
                            <Border Style="{StaticResource Card}" AutomationId="{Binding AutomationId}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenCommand}"/></Border.GestureRecognizers>
                                <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                    <Grid WidthRequest="56" HeightRequest="56">
                                        <Border IsVisible="{Binding ShowInitials}" BackgroundColor="{StaticResource BrandSecondary}" StrokeThickness="0" StrokeShape="RoundRectangle 28">
                                            <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Image Source="{Binding Photo}" IsVisible="{Binding HasPhoto}" Aspect="AspectFill">
                                            <Image.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/></Image.Clip>
                                        </Image>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource SubtitleText}"/>
                                        <Label Text="{Binding Tagline}" Style="{StaticResource BodyText}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                      </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
