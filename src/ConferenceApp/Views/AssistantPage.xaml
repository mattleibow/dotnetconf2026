<ContentPage x:Class="ConferenceApp.Views.AssistantPage"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels"
             x:DataType="vm:AssistantViewModel"
             Title="Assistant"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <Grid RowDefinitions="Auto,*">
        <Border Background="{StaticResource BrandGradient}" StrokeThickness="0" Padding="24,16">
            <Grid ColumnDefinitions="*,Auto" MaximumWidthRequest="1100" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Conference assistant" Style="{StaticResource HeaderTitle}" />
                    <Label Text="On-device by default · cloud is optional" Style="{StaticResource HeaderText}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="New chat" Style="{StaticResource CityButton}" AutomationId="assistant-new-chat" Command="{Binding NewChatCommand}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" MaximumWidthRequest="1100" HorizontalOptions="Fill" Padding="16" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Status}" AutomationId="assistant-status" Style="{StaticResource SearchMatchText}" />
                <Button Text="{Binding CloudSettingsLabel}" AutomationId="assistant-cloud-settings" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Command="{Binding ToggleCloudSettingsCommand}" />
                <VerticalStackLayout IsVisible="{Binding ShowCloudSettings}" Spacing="4">
                    <Label Text="{Binding CloudStatus}" AutomationId="assistant-cloud-status" Style="{StaticResource SearchMatchText}" />
                    <VerticalStackLayout IsVisible="{Binding IsCloudDisabled}" Spacing="4">
                        <Label Text="Short-lived GitHub Models key" Style="{StaticResource SearchMatchText}" />
                        <Entry Placeholder="Enter key" PlaceholderColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" IsPassword="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" AutomationId="assistant-cloud-key" SemanticProperties.Description="Short-lived GitHub Models key, kept in memory only" Text="{Binding CloudKey}" />
                        <Button Text="Enable cloud" AutomationId="assistant-cloud-enable" Command="{Binding EnableCloudCommand}" />
                    </VerticalStackLayout>
                    <Button Text="Turn off cloud" IsVisible="{Binding IsCloudEnabled}" HorizontalOptions="Start" AutomationId="assistant-cloud-disable" Command="{Binding DisableCloudCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Row="1" IsVisible="{Binding IsDebug}" Spacing="8">
                <Switch AutomationId="assistant-simulated-time-enabled" IsToggled="{Binding UseSimulatedTime}" SemanticProperties.Description="Use a simulated time on event day" />
                <Label Text="Debug: event day time" VerticalOptions="Center" />
                <TimePicker AutomationId="assistant-simulated-time" Time="{Binding SimulatedTime}" IsEnabled="{Binding UseSimulatedTime}" />
            </HorizontalStackLayout>
            <CollectionView Grid.Row="2" AutomationId="assistant-messages" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="16">
                        <Label Text="Ask about the agenda" Style="{StaticResource TitleText}" HorizontalTextAlignment="Center" />
                        <Label Text="Try “What’s on after lunch?” or ask about a speaker’s session." Style="{StaticResource SearchMatchText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssistantMessage">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" MaximumWidthRequest="760" HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Role}" Style="{StaticResource Metadata}" />
                                <Label Text="{Binding Text}" AutomationId="assistant-message-text" />
                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Sessions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssistantSessionLink">
                                            <Border Style="{StaticResource SessionLink}" AutomationId="{Binding AutomationId}"
                                                    SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="Open session details">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssistantViewModel}}, Path=OpenSessionCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Metadata}" Style="{StaticResource Metadata}" IsVisible="{Binding HasMetadata}" />
                                                    <Label Text="{Binding Title}" Style="{StaticResource SessionLinkText}" />
                                                    <Label Text="{Binding Reason}" IsVisible="{Binding HasReason}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border Grid.Row="3" Style="{StaticResource Card}" IsVisible="{Binding Approval.IsPending}" AutomationId="favourite-approval-card"
                    MaximumWidthRequest="760" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Approve favourite change?" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding Approval.Description}" AutomationId="favourite-approval-description" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Approve" AutomationId="favourite-approve" Command="{Binding Approval.ApproveCommand}" />
                        <Button Text="Deny" Style="{StaticResource SecondaryButton}" AutomationId="favourite-deny" Command="{Binding Approval.DenyCommand}" />
                        <Button Text="Stop" SemanticProperties.Description="Stop assistant request" Style="{StaticResource SecondaryButton}" AutomationId="favourite-cancel" Command="{Binding CancelCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Grid Grid.Row="4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding Approval.IsPending}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <Entry Grid.ColumnSpan="3" Placeholder="Ask about the conference" PlaceholderColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" AutomationId="assistant-input" SemanticProperties.Description="Your question or planning preferences" Text="{Binding Input}" MaxLength="500" IsEnabled="{Binding IsAvailable}" ReturnCommand="{Binding SendCommand}" />
                <Button Grid.Row="1" Text="Plan my day" AutomationId="plan-my-day" Command="{Binding PlanDayCommand}" IsEnabled="{Binding IsAvailable}" HorizontalOptions="Start" />
                <Button Grid.Row="1" Grid.Column="1" Text="Send" AutomationId="assistant-send" Command="{Binding SendCommand}" IsEnabled="{Binding IsAvailable}" />
                <Button Grid.Row="1" Grid.Column="2" Text="Cancel" AutomationId="assistant-cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
