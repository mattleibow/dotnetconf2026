<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConferenceApp.ViewModels" x:Class="ConferenceApp.Views.AssistantPage"
             x:DataType="vm:AssistantViewModel" Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <Grid RowDefinitions="Auto,*">
        <Grid Background="{StaticResource BrandGradient}">
            <Grid Padding="24,20,24,20" MaximumWidthRequest="1100" HorizontalOptions="Fill" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text=".NET CONF 2026  •  SOUTH AFRICA" TextColor="White" Style="{StaticResource CaptionText}"/>
                    <Label Text="Assistant" TextColor="White" Style="{StaticResource DisplayText}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="New chat" Command="{Binding NewChatCommand}" AutomationId="assistant-new-chat" VerticalOptions="Center"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="16" MaximumWidthRequest="800" HorizontalOptions="Fill" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Notice}" Style="{StaticResource BodyText}" AutomationId="assistant-status" VerticalOptions="Center"/>
                <Button x:Name="DebugClockButton" Grid.Column="1" Text="Debug clock" Command="{Binding ToggleDebugClockCommand}" AutomationId="assistant-clock" IsVisible="False"/>
            </Grid>
            <HorizontalStackLayout Grid.Row="1" IsVisible="{Binding ShowDebugClock}" Spacing="8">
                <Label Text="Simulate event-day time" VerticalOptions="Center" Style="{StaticResource BodyText}"/>
                <Switch IsToggled="{Binding UseEventTime}" AutomationId="assistant-clock-enabled"/>
                <TimePicker Time="{Binding EventTime}" AutomationId="assistant-clock-time"/>
            </HorizontalStackLayout>
            <Label Grid.Row="2" Text="Debug: simulating event-day time" IsVisible="{Binding UseEventTime}" Style="{StaticResource MetadataText}" AutomationId="assistant-clock-active"/>
            <CollectionView x:Name="MessageList" Grid.Row="3" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView" AutomationId="assistant-messages">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ask your conference assistant" Style="{StaticResource SubtitleText}"/>
                            <Label Text="Ask a question, or describe your interests and departure time to plan your day." Style="{StaticResource BodyText}"/>
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssistantMessage">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" IsVisible="{Binding IsVisible}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Author}" Style="{StaticResource MetadataText}"/>
                                <Label Text="{Binding Text}" Style="{StaticResource BodyText}"/>
                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Sessions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionItem">
                                            <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" StrokeShape="RoundRectangle 12"
                                                    Padding="12" MinimumHeightRequest="48" AutomationId="{Binding AssistantAutomationId}"
                                                    SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="Open session details">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenCommand}"/>
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Title}" Style="{StaticResource SubtitleText}" SemanticProperties.HeadingLevel="Level2"/>
                                                    <Label Text="{Binding Time}" Style="{StaticResource MetadataText}"/>
                                                    <Label Text="{Binding Speakers}" Style="{StaticResource BodyText}"/>
                                                    <Label Text="{Binding MatchText}" IsVisible="{Binding HasMatchText}" Style="{StaticResource BodyText}"/>
                                                    <Label Text="View session" Style="{StaticResource MetadataText}"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border Grid.Row="4" Style="{StaticResource Card}" Stroke="{StaticResource BrandGradient}" StrokeThickness="2"
                    IsVisible="{Binding Approval.IsPending}" AutomationId="favorite-approval-card">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Approval required" Style="{StaticResource SubtitleText}"/>
                    <Label Text="{Binding Approval.Description}" Style="{StaticResource BodyText}" AutomationId="favorite-approval-description"/>
                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Approve" Command="{Binding Approval.ApproveCommand}" AutomationId="favorite-approve"
                                SemanticProperties.Description="{Binding Approval.Description, StringFormat='Approve: {0}'}"/>
                        <Button Text="Deny" Command="{Binding Approval.DenyCommand}" AutomationId="favorite-deny"
                                BackgroundColor="Transparent" BorderWidth="1" BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                SemanticProperties.Description="{Binding Approval.Description, StringFormat='Deny: {0}'}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Grid Grid.Row="5" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Entry Placeholder="Ask a question or describe your day" PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}" Text="{Binding Input}" IsEnabled="{Binding IsAvailable}" AutomationId="assistant-input" ReturnCommand="{Binding SendCommand}" SemanticProperties.Description="Ask a question or describe your interests and departure time"/>
                <Button Grid.Column="1" Text="Send" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" AutomationId="assistant-send"/>
                <Button Grid.Column="2" Text="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" AutomationId="assistant-stop"/>
                <Button Grid.Row="1" Grid.ColumnSpan="3" Text="Plan my day" Command="{Binding PlanDayCommand}" IsEnabled="{Binding CanSend}" AutomationId="plan-my-day" SemanticProperties.Description="Plan my day from the request above"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
